# Required
# Search: https://tavily.com (free tier is enough)
TAVILY_API_KEY=
# Any OpenAI-compatible chat completions endpoint with tool calling.
LLM_API_KEY=

# Optional (defaults shown)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
PORT=3000
# Timezone used to resolve "Monday", "last Tuesday", "yesterday". Defaults to the machine timezone.
AGENT_TZ=
# Where conversation history is stored.
DATA_DIR=./data
